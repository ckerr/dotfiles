#!/bin/zsh
# source: https://stackoverflow.com/questions/7599447/less-style-markdown-viewer-for-unix-systems/20197316#20197316

case "$1" in
    *.md|*.markdown)
        # lesspipe already pipes us into less, so no -p: less does the paging.
        # --style is what keeps the ANSI colour when stdout is a pipe, and
        # less renders it because of --RAW-CONTROL-CHARS in $LESS.
        glow --style=dark "$1"
        ;;
    *)
        # We don't handle this format.
        exit 1
esac

# No further processing by lesspipe necessary
exit 0
